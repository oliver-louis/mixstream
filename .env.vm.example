# LAN/dev deployment template for a generic Docker host.
# Copy to .env on the VM and replace <VM-IP> plus the secret values.

DJANGO_SECRET_KEY=replace-with-random-secret-from-openssl-rand-base64-32
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<VM-IP>
DJANGO_CSRF_TRUSTED_ORIGINS=http://<VM-IP>:8081
USE_X_FORWARDED_HOST=true
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

POSTGRES_DB=mixstream
POSTGRES_USER=mixstream
POSTGRES_PASSWORD=replace-with-random-postgres-password

NAS_MEDIA_PATH=/opt/stacks/mixstream/media
APP_PORT=8081
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
DJMIX_MAX_UPLOAD_BYTES=3221225472
DJMIX_MAX_COVER_PIXELS=40000000
DJMIX_COVER_LARGE_SIZE=1600
DJMIX_COVER_THUMB_SIZE=480
DJMIX_OPUS_BITRATE=128k
DJMIX_MP3_BITRATE=192k
DJMIX_VIEW_DEDUPE_MINUTES=30
DJMIX_STREAM_DEDUPE_MINUTES=360
DJANGO_LOG_LEVEL=INFO

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-password
LOKI_RETENTION=168h

# Leave OIDC off for first LAN/dev boot. Login will use Django's admin login.
OIDC_ENABLED=false
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile

DJMIX_REQUIRE_GROUP=false
DJMIX_USER_GROUP=djmix-users
DJMIX_ADMIN_GROUP=djmix-admins
DJMIX_INTERNAL_MEDIA_PREFIX=/protected-media/
