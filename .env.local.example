DJANGO_SECRET_KEY=local-dev-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://10.0.0.198:8088
USE_X_FORWARDED_HOST=true
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

POSTGRES_DB=mixstream
POSTGRES_USER=mixstream
POSTGRES_PASSWORD=mixshelf-local

NAS_MEDIA_PATH=./local-media
APP_PORT=8088
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
DJMIX_MAX_UPLOAD_BYTES=3221225472
DJMIX_MAX_COVER_PIXELS=40000000
DJMIX_COVER_LARGE_SIZE=1600
DJMIX_COVER_THUMB_SIZE=480
DJMIX_OPUS_BITRATE=128k
DJMIX_MP3_BITRATE=192k

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=mixstream-local-grafana
LOKI_RETENTION=168h

OIDC_ENABLED=true
OIDC_RP_CLIENT_ID=replace-with-authentik-client-id
OIDC_RP_CLIENT_SECRET=replace-with-authentik-client-secret

# Use a URL the Django container can reach. If authentik runs on your Mac,
# host.docker.internal is usually the right hostname from inside Docker.
OIDC_OP_AUTHORIZATION_ENDPOINT=http://host.docker.internal:9000/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=http://host.docker.internal:9000/application/o/token/
OIDC_OP_USER_ENDPOINT=http://host.docker.internal:9000/application/o/userinfo/
OIDC_OP_JWKS_ENDPOINT=http://host.docker.internal:9000/application/o/mixshelf/jwks/
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile

DJMIX_REQUIRE_GROUP=true
DJMIX_USER_GROUP=djmix-users
DJMIX_ADMIN_GROUP=djmix-admins
DJMIX_INTERNAL_MEDIA_PREFIX=/protected-media/
