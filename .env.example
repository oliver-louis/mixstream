# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-50-plus-character-random-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=mixes.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mixes.example.com
USE_X_FORWARDED_HOST=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=604800
SESSION_SAVE_EVERY_REQUEST=false
SESSION_EXPIRE_AT_BROWSER_CLOSE=false
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

POSTGRES_DB=mixstream
POSTGRES_USER=mixstream
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

NAS_MEDIA_PATH=/mnt/nas/mixstream-media
APP_PORT=8088
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
DJMIX_MAX_UPLOAD_BYTES=3221225472
DJMIX_MAX_COVER_PIXELS=40000000
DJMIX_COVER_LARGE_SIZE=1600
DJMIX_COVER_THUMB_SIZE=480
DJMIX_OPUS_BITRATE=128k
DJMIX_MP3_BITRATE=192k
DJMIX_VIEW_DEDUPE_MINUTES=30
DJMIX_STREAM_DEDUPE_MINUTES=360
DJANGO_LOG_LEVEL=INFO
DJMIX_MAX_CHUNK_BYTES=99614720

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
LOKI_RETENTION=168h

OIDC_ENABLED=true
OIDC_RP_CLIENT_ID=replace-with-authentik-client-id
OIDC_RP_CLIENT_SECRET=replace-with-authentik-client-secret
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.example.com/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=https://auth.example.com/application/o/token/
OIDC_OP_USER_ENDPOINT=https://auth.example.com/application/o/userinfo/
OIDC_OP_JWKS_ENDPOINT=https://auth.example.com/application/o/mixshelf/jwks/
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile

DJMIX_REQUIRE_GROUP=true
DJMIX_USER_GROUP=djmix-users
DJMIX_ADMIN_GROUP=djmix-admins
DJMIX_INTERNAL_MEDIA_PREFIX=/protected-media/
